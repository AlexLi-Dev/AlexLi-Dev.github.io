---
import { siteConfig } from "../config";
---

<section id="about" class="section-shell">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="section-kicker">WHO I AM</p>
      <h2 class="section-title">关于我</h2>
      <div class="section-rule" style={{ backgroundColor: siteConfig.accentColor }}></div>
    </div>

    <div class="space-y-8 lg:col-span-8">
      <div class="space-y-5">
        {siteConfig.about.map((paragraph, index) => (
          <p class:list={["leading-relaxed text-gray-600", index === 0 ? "text-lg sm:text-xl md:text-2xl" : "text-base sm:text-lg"]}>
            {paragraph}
          </p>
        ))}
      </div>

      <div class="grid gap-3 pt-2 sm:grid-cols-2">
        {siteConfig.capabilityGroups.map((group) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-5">
            <h3 class="text-sm font-bold text-gray-900">{group.name}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
