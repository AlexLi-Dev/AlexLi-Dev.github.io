---
import { siteConfig } from "../config";
---

<section id="experience" class="section-shell">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="section-kicker">EXPERIENCE</p>
      <h2 class="section-title">工作经历</h2>
      <div class="section-rule" style={{ backgroundColor: siteConfig.accentColor }}></div>
    </div>

    <div class="lg:col-span-8">
      {siteConfig.experience.map((experience) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
            <div>
              <h3 class="text-xl font-bold text-gray-900">{experience.title}</h3>
              <div class="mt-2 flex items-center gap-2">
                <img src={experience.logo} alt="" aria-hidden="true" class="h-5 w-auto object-contain" />
                <p class="text-sm font-semibold" style={{ color: siteConfig.accentColor }}>{experience.company}</p>
              </div>
            </div>
          </div>
          <ul class="mt-7 space-y-4">
            {experience.bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-gray-600 sm:text-base">
                <span class="mt-2 size-1.5 shrink-0 rounded-full" style={{ backgroundColor: siteConfig.accentColor }}></span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
