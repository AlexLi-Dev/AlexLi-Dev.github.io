---
import { siteConfig } from "../config";
const notes = siteConfig.notes;
const featured = notes.featured;
const accent = siteConfig.accentColor;
---

<section id="notes" class="section-shell">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="section-kicker">ENGINEERING NOTES</p>
      <h2 class="section-title">工程笔记</h2>
      <div class="section-rule" style={{ backgroundColor: accent }}></div>
    </div>

    <div class="space-y-4 lg:col-span-8">
      <div class="relative overflow-hidden rounded-2xl bg-gray-900 p-6 text-white sm:p-8">
        <div
          class="absolute -right-20 -top-24 size-64 rounded-full"
          style={`background: radial-gradient(circle, ${accent}66 0%, transparent 70%)`}
        ></div>
        <div class="relative z-10 flex flex-col gap-6 sm:flex-row sm:items-start">
          <img src="/logos/notes.svg" alt="Engineering Notes" class="h-12 w-auto shrink-0 rounded-lg bg-white/10 p-1.5 object-contain" />
          <div>
            <p class="text-xs font-bold tracking-[0.18em]" style={`color:${accent}`}>KNOWLEDGE BASE</p>
            <h3 class="mt-3 text-2xl font-bold sm:text-3xl">把经验沉淀成可复用的知识</h3>
            <p class="mt-4 text-sm leading-relaxed text-gray-300 sm:text-base">{notes.intro}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {notes.impactFacts.map((fact) => (
                <span class="rounded-full border border-gray-700 bg-gray-800 px-3 py-1.5 text-xs font-semibold text-gray-200">{fact}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <article class="rounded-2xl border border-gray-200 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-xl sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-5">
          <div class="flex items-center gap-4">
            <img src="/logos/notes.svg" alt="Engineering Notes" class="h-10 w-auto object-contain" />
            <div>
              <h3 class="text-xl font-bold text-gray-900 sm:text-2xl">{featured.name}</h3>
              <p class="mt-1 text-sm text-gray-500">{featured.tagline}</p>
            </div>
          </div>
          <a href={featured.repoLink} target="_blank" rel="noopener noreferrer" class="rounded-full px-4 py-2 text-xs font-bold text-white" style={{ backgroundColor: accent }}>查看全部笔记 ↗</a>
        </div>

        <div class="mt-7 grid gap-4 sm:grid-cols-[auto_1fr_auto_1fr_auto] sm:items-center">
          {featured.flow.map((step, index) => (
            <Fragment>
              <span class="rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-center text-xs font-bold text-gray-700">{step}</span>
              {index < featured.flow.length - 1 && <span class="hidden h-px bg-gray-300 sm:block"></span>}
            </Fragment>
          ))}
        </div>

        <h4 class="mt-7 text-lg font-bold text-gray-900 sm:text-xl">{featured.title}</h4>
        <p class="mt-3 text-sm leading-relaxed text-gray-600 sm:text-base">{featured.description}</p>
        <p class="mt-5 border-l-2 pl-4 text-sm font-semibold leading-relaxed text-gray-800" style={{ borderColor: accent }}>{featured.proof}</p>
      </article>
    </div>
  </div>
</section>
