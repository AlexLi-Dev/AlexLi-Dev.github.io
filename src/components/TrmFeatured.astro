---
import { siteConfig } from "../config";
const project = siteConfig.trm;
const accent = siteConfig.accentColor;
const activeStep = project.activeStep;
---

<section id="trm" class="section-shell">
  <div class="relative overflow-hidden rounded-3xl border border-gray-200 bg-white p-7 sm:p-10 md:p-14 lg:p-16">
    <div
      class="absolute -right-36 -top-36 -z-0 size-96 rounded-full"
      style={`background: radial-gradient(circle, ${accent}20 0%, transparent 70%)`}
    ></div>

    <div class="relative z-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-4">
          <img src={project.logo} alt="TRM Logo" class="size-16 rounded-2xl object-cover sm:size-20" />
          <div>
            <p class="font-mono text-xs font-bold tracking-[0.18em]" style={{ color: accent }}>FEATURED CLOUD PLATFORM</p>
            <p class="mt-1 text-xs text-gray-500">Multi-cluster · AIOps · FinOps</p>
          </div>
        </div>

        <h2 class="mt-7 text-4xl font-bold text-gray-900 sm:text-5xl md:text-6xl">
          {project.name}
        </h2>
        <p class="mt-3 text-lg font-bold" style={{ color: accent }}>{project.chineseName}</p>
        <p class="mt-4 text-base font-semibold leading-relaxed text-gray-700">{project.tagline}</p>
        <p class="mt-5 text-base leading-relaxed text-gray-600 sm:text-lg">{project.summary}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={project.caseStudy} class="inline-flex items-center rounded-lg px-5 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:shadow-lg" style={{ backgroundColor: accent }}>
            阅读完整 Case Study →
          </a>
          <a href={project.repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 transition-all hover:-translate-y-0.5 hover:bg-gray-50">
            GitHub 源码 ↗
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_250px] lg:grid-cols-[minmax(0,1fr)_270px]">
          <div>
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5 sm:p-7">
              <p class="text-xs font-bold tracking-[0.18em] text-gray-500">研运闭环</p>
              <div class="mt-5 space-y-2">
                {project.loop.map((step, index) => {
                  const isCore = index === activeStep;
                  return (
                    <div class="relative flex min-w-0 items-center gap-3">
                      <span
                        class="relative z-10 flex size-7 shrink-0 items-center justify-center rounded-full border font-mono text-[9px] font-bold"
                        style={isCore
                          ? `border-color:${accent};background:${accent};color:#fff`
                          : "border-color:#d1d5db;background:#fff;color:#6b7280"}
                      >
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <div
                        class="flex min-h-11 min-w-0 flex-1 items-center justify-between gap-3 rounded-xl border px-3 text-xs font-bold"
                        style={isCore
                          ? `border-color:${accent};background:${accent};color:#fff`
                          : "border-color:#d1d5db;background:#fff;color:#374151"}
                      >
                        <span>{step}</span>
                        {isCore && <span class="font-mono text-[9px] tracking-[0.12em] opacity-80">CORE</span>}
                      </div>
                      {index < project.loop.length - 1 && (
                        <span class="absolute left-[13px] top-full h-2 border-l border-dashed border-gray-300"></span>
                      )}
                    </div>
                  );
                })}
              </div>
              <p class="mt-4 text-xs leading-relaxed text-gray-500">多集群统一接入，工作负载与 CICD 流水线化交付，AIOps 负责智能运维，FinOps 完成成本闭环。</p>
            </div>

            <div class="mt-4 space-y-2">
              {project.facts.map((fact) => (
                <div class="flex min-h-14 items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white px-4 py-3">
                  <p class="shrink-0 font-mono text-xl font-bold text-gray-900 sm:text-2xl">{fact.value}</p>
                  <p class="text-right text-[10px] leading-relaxed text-gray-500 sm:text-xs">{fact.label}</p>
                </div>
              ))}
            </div>

          </div>

          <div class="order-first mx-auto w-full max-w-[280px] self-start sm:order-last">
            <figure>
              <div class="relative overflow-hidden rounded-2xl border border-gray-800 bg-gray-900 shadow-2xl shadow-gray-900/25">
                <div class="flex items-center gap-1.5 border-b border-gray-800 bg-gray-950 px-3 py-2">
                  <span class="size-2 rounded-full bg-red-400"></span>
                  <span class="size-2 rounded-full bg-yellow-400"></span>
                  <span class="size-2 rounded-full bg-green-400"></span>
                  <span class="ml-2 flex-1 truncate rounded-full bg-gray-800 px-2 py-0.5 font-mono text-[8px] text-gray-400">trm.cloud/console</span>
                </div>
                <img
                  src={project.console}
                  alt="TRM 云原生平台集群总览真实界面"
                  class="block w-full bg-[#0b1220]"
                  loading="lazy"
                />
              </div>
              <figcaption class="mt-3 text-center font-mono text-[10px] font-bold tracking-[0.14em] text-gray-400">TRM CONSOLE · CLUSTER OVERVIEW</figcaption>
            </figure>

            <div class="mt-4 rounded-2xl interface-note border border-gray-200 bg-white p-4">
              <p class="flex items-center gap-2 font-mono text-[10px] font-bold tracking-[0.16em] text-gray-500">
                <span class="size-2 rounded-full" style={{ backgroundColor: accent }}></span>
                REAL PLATFORM UI
              </p>
              <p class="mt-2 text-xs leading-relaxed text-gray-500">真实平台界面：集群总览、健康状态、资源用量与告警入口。</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="relative z-10 mt-12 grid gap-px overflow-hidden rounded-2xl border border-gray-200 bg-gray-200 sm:grid-cols-2 lg:grid-cols-4">
      {project.capabilities.map((capability) => (
        <article class="bg-white p-5 sm:p-6">
          <span class="font-mono text-xs font-bold" style={{ color: accent }}>{capability.index}</span>
          <h3 class="mt-4 text-base font-bold text-gray-900">{capability.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">{capability.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
