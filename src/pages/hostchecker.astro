---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";

const project = siteConfig.hostChecker;
const accent = siteConfig.accentColor;
const activeStep = project.activeStep;

const executionSteps = [
  { name: "Scheduler", detail: "定时触发巡检" },
  { name: "Discovery", detail: "同步主机清单" },
  { name: "TCP Probe", detail: "端口连通性探测" },
  { name: "SSH Probe", detail: "握手与认证检查" },
  { name: "Aggregate", detail: "结果聚合去重" },
  { name: "InfluxDB", detail: "写入时序指标" },
  { name: "Alert", detail: "告警与看板" },
];

const capabilityDetails = [
  {
    title: "01 / Scheduling & Discovery",
    intro: "让巡检目标和调度节奏都由系统管理。",
    bullets: [
      "Scheduler 按固定节奏触发，支持并发批次与错开调度，避免瞬时探测风暴。",
      "Discovery 从主机清单自动同步目标，新增与下线节点自动进入或退出巡检。",
      "每个目标带环境、区域与角色标签，告警与指标可以按维度聚合。",
    ],
  },
  {
    title: "02 / Probe Engineering",
    intro: "用超时、重试和并发预算约束网络的不确定性。",
    bullets: [
      "TCP 探测检查端口可达性；SSH 探测验证握手、认证与 banner 响应。",
      "统一超时、有限重试与并发上限，区分连接失败、认证失败与超时三类结果。",
      "探测端自身有资源预算，避免巡检系统反过来压垮被巡检的服务。",
    ],
  },
  {
    title: "03 / Metrics & Storage",
    intro: "让每一次探测都留下可查询的历史。",
    bullets: [
      "结果聚合去重后批量写入 InfluxDB，记录可用性、延迟与失败原因。",
      "指标按主机、区域、协议打标签，支撑 SLI 计算、趋势分析与容量判断。",
      "配置保留周期与降采样策略，控制存储成本，同时保留长期可用性证据。",
    ],
  },
  {
    title: "04 / Alerting & Observability",
    intro: "异常要被看见，更要被分级处理。",
    bullets: [
      "按失败次数、持续时长与环境级别触发告警，支持抑制与聚合，减少噪音。",
      "Grafana 看板呈现可用性、探测延迟、失败分布与告警状态。",
      "告警附带主机、最近变更与排查入口，缩短从发现到定位的时间。",
    ],
  },
];
---

<BaseLayout
  title="HostChecker Case Study - Alex Li"
  description="主机巡检 HostChecker 的产品设计、调度发现、TCP/SSH 探测、InfluxDB 指标流水线与告警可观测性。"
  canonicalPath="/hostchecker/"
  homePath="/"
>
  <section class="relative overflow-hidden px-8 pb-20 pt-32 sm:px-12 md:px-16 md:pb-28 md:pt-40 lg:px-24">
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:64px_64px] opacity-45"></div>
    <div class="absolute left-0 top-0 -z-10 h-full w-2/3 bg-gradient-to-r from-emerald-50/90 to-transparent"></div>
    <div class="mx-auto max-w-7xl">
      <a href="/#hostchecker" class="text-sm font-semibold text-gray-600 hover:text-gray-900">← 返回首页</a>
      <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <div class="flex items-center gap-4">
            <img src="/hostchecker/logo.svg" alt="HostChecker Logo" class="size-16 rounded-2xl object-cover sm:size-20" />
            <div>
              <p class="text-xs font-bold tracking-[0.18em] text-emerald-700">PRODUCT & ENGINEERING CASE STUDY</p>
              <p class="mt-1 text-xs text-gray-500">Continuous scheduling · Go · Linux</p>
            </div>
          </div>
          <h1 class="mt-8 text-5xl font-bold tracking-tight text-gray-900 sm:text-6xl md:text-8xl">{project.chineseName} <span class="text-gray-400">/</span> {project.name}</h1>
          <p class="mt-6 max-w-4xl text-xl font-semibold leading-relaxed text-gray-700 sm:text-2xl">{project.tagline}</p>
          <p class="mt-6 max-w-4xl text-base leading-relaxed text-gray-600 sm:text-lg">{project.summary}</p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <a href={project.repo} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-lg px-5 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:shadow-lg" style={{ backgroundColor: accent }}>查看公开源码 ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-8 pb-20 pt-0 sm:px-12 md:px-16 md:pb-28 lg:px-24">
    <div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-gray-950 text-white">
      <div class="grid lg:grid-cols-12">
        <div class="p-8 sm:p-12 lg:col-span-5 lg:p-14">
          <div class="flex items-center gap-3">
            <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_18px_rgba(52,211,153,0.8)]"></span>
            <p class="font-mono text-xs font-bold tracking-[0.18em] text-gray-400">REAL PIPELINE · GO</p>
          </div>
          <h2 class="mt-6 text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">真实系统，<br />不是概念图。</h2>
          <p class="mt-6 text-sm leading-relaxed text-gray-400 sm:text-base">这块监控看板来自 HostChecker 的实际运行界面。运维同学可以按环境、区域或主机查看可用性，也能看到失败原因、探测延迟和当前告警状态。</p>

          <div class="mt-9 space-y-3">
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
              <p class="font-mono text-[10px] font-bold tracking-[0.16em] text-emerald-400">01 / HOST DISCOVERY</p>
              <p class="mt-2 text-sm text-gray-300">主机清单自动同步，新增节点自动纳入巡检范围。</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
              <p class="font-mono text-[10px] font-bold tracking-[0.16em] text-emerald-400">02 / PROBE STATUS</p>
              <p class="mt-2 text-sm text-gray-300">TCP / SSH 探测结果、延迟与失败原因一目了然。</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
              <p class="font-mono text-[10px] font-bold tracking-[0.16em] text-emerald-400">03 / METRICS & ALERT</p>
              <p class="mt-2 text-sm text-gray-300">可用性趋势可回溯，异常按分级规则自动告警。</p>
            </div>
          </div>

          <p class="mt-8 text-xs leading-relaxed text-gray-600">截图来自开发构建；界面与数据仍在持续迭代。</p>
        </div>

        <div class="relative flex min-h-[560px] items-center justify-center overflow-hidden border-t border-white/10 bg-[radial-gradient(circle_at_50%_30%,rgba(16,185,129,0.24),transparent_58%)] p-8 sm:p-12 lg:col-span-7 lg:min-h-[760px] lg:border-l lg:border-t-0">
          <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
          <div class="absolute left-8 top-8 font-mono text-[10px] tracking-[0.16em] text-gray-600">LIVE DASHBOARD / 2026</div>

          <figure class="relative z-10 w-full max-w-[560px]">
            <div class="relative overflow-hidden rounded-2xl border border-gray-800 bg-gray-900 shadow-[0_40px_100px_rgba(0,0,0,0.55)]">
              <div class="flex items-center gap-1.5 border-b border-gray-800 bg-gray-950 px-4 py-2.5">
                <span class="size-2.5 rounded-full bg-red-400"></span>
                <span class="size-2.5 rounded-full bg-yellow-400"></span>
                <span class="size-2.5 rounded-full bg-green-400"></span>
                <span class="ml-2 flex-1 truncate rounded-full bg-gray-800 px-3 py-1 text-left font-mono text-[9px] text-gray-400">ops.example.com/hosts</span>
              </div>
              <img
                src={project.dashboard}
                alt="HostChecker 监控看板完整截图"
                class="block w-full bg-[#0b1220]"
                loading="lazy"
              />
            </div>
            <figcaption class="mt-4 text-center font-mono text-[10px] font-bold tracking-[0.14em] text-gray-500">HOST STATUS DASHBOARD · ACTUAL BUILD</figcaption>
          </figure>

          <div class="absolute right-8 top-28 hidden rounded-xl border border-white/10 bg-gray-950/85 px-3 py-2 text-[10px] font-semibold text-gray-300 backdrop-blur xl:block">Availability SLI</div>
          <div class="absolute bottom-36 left-8 hidden rounded-xl border border-white/10 bg-gray-950/85 px-3 py-2 text-[10px] font-semibold text-gray-300 backdrop-blur xl:block">Failure reasons</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="section-kicker">01 / PRODUCT THESIS</p>
          <h2 class="section-title">让巡检持续运行，<br />而不是临渴掘井</h2>
          <div class="section-rule" style={{ backgroundColor: accent }}></div>
        </div>
        <div class="lg:col-span-8">
          <p class="text-lg leading-relaxed text-gray-600 sm:text-xl md:text-2xl">手动巡检依赖人的记忆和责任心，故障往往发生在没人检查的时候。HostChecker 把巡检变成持续运行的流水线：系统自动发现目标、执行探测、沉淀指标，异常在影响用户之前就被发现。</p>
          <div class="mt-10 grid grid-cols-5 gap-1 sm:gap-3">
            {project.loop.map((step, index) => (
              <div class="relative min-w-0">
                <div
                  class="flex h-20 items-center justify-center rounded-xl border px-1 text-center text-[10px] font-bold sm:text-sm"
                  style={index === activeStep
                    ? `border-color:${accent};background:${accent};color:#fff`
                    : "border-color:#d1d5db;background:#fff;color:#374151"}
                >{step}</div>
                {index < project.loop.length - 1 && <span class="absolute -right-2 top-1/2 z-10 -translate-y-1/2 bg-white text-gray-400 sm:-right-3">→</span>}
              </div>
            ))}
          </div>
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-gray-200 p-5"><p class="text-sm font-bold text-gray-900">Automated</p><p class="mt-2 text-xs leading-relaxed text-gray-500">定时自动执行，不依赖人记得去检查。</p></div>
            <div class="rounded-2xl border border-gray-200 p-5"><p class="text-sm font-bold text-gray-900">Reliable</p><p class="mt-2 text-xs leading-relaxed text-gray-500">超时、重试与并发预算，避免假阳性和探测风暴。</p></div>
            <div class="rounded-2xl border border-gray-200 p-5"><p class="text-sm font-bold text-gray-900">Observable</p><p class="mt-2 text-xs leading-relaxed text-gray-500">结果写入时序库，可用性历史可查询、可回溯。</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-950 px-8 py-20 text-white sm:px-12 md:px-16 md:py-28 lg:px-24">
    <div class="mx-auto max-w-7xl">
      <p class="text-xs font-bold tracking-[0.18em] text-emerald-400">02 / DETERMINISTIC EXECUTION PIPELINE</p>
      <h2 class="mt-4 max-w-4xl text-3xl font-bold leading-tight sm:text-4xl md:text-6xl">调度器决定何时运行，代码决定系统能做什么。</h2>
      <div class="mt-12 grid gap-3 md:grid-cols-7">
        {executionSteps.map((step, index) => (
          <div class="relative rounded-2xl border border-gray-800 bg-gray-900 p-4">
            <span class="font-mono text-xs text-gray-600">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-5 text-sm font-bold text-white">{step.name}</h3>
            <p class="mt-2 text-xs leading-relaxed text-gray-400">{step.detail}</p>
            {index < executionSteps.length - 1 && <span class="absolute -bottom-3 left-1/2 z-10 -translate-x-1/2 text-gray-600 md:-right-2.5 md:bottom-auto md:left-auto md:top-1/2 md:translate-x-0 md:-translate-y-1/2">→</span>}
          </div>
        ))}
      </div>
      <p class="mt-6 max-w-4xl text-sm leading-relaxed text-gray-400">正常路径包含 TCP 与 SSH 两类探测：探测失败按有限次数重试，结果聚合后批量写入 InfluxDB，告警由独立规则引擎评估，避免单次抖动直接呼叫值班人。</p>
    </div>
  </section>

  <section class="section-shell">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-px overflow-hidden rounded-3xl border border-gray-200 bg-gray-200 md:grid-cols-2">
        {capabilityDetails.map((capability) => (
          <article class="bg-white p-7 sm:p-9">
            <h2 class="text-xl font-bold text-gray-900 sm:text-2xl">{capability.title}</h2>
            <p class="mt-4 text-sm font-semibold text-emerald-700">{capability.intro}</p>
            <ul class="mt-6 space-y-4">
              {capability.bullets.map((bullet) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-gray-600"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-emerald-700"></span><span>{bullet}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell pt-0">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="section-kicker">03 / EVALUATION</p>
        <h2 class="section-title">把“系统稳定”<br />变成可以度量的目标</h2>
        <div class="section-rule" style={{ backgroundColor: accent }}></div>
      </div>
      <div class="lg:col-span-8">
        <div class="rounded-3xl border border-gray-200 bg-gray-50 p-7 sm:p-10">
          <div class="grid gap-4 sm:grid-cols-3">
            <div><p class="text-3xl font-bold text-gray-900">99.99%</p><p class="mt-1 text-xs text-gray-500">可用性 SLI 目标</p></div>
            <div><p class="text-3xl font-bold text-gray-900">24×7</p><p class="mt-1 text-xs text-gray-500">自动巡检覆盖</p></div>
            <div><p class="text-3xl font-bold text-gray-900">MTTR</p><p class="mt-1 text-xs text-gray-500">持续度量与复盘</p></div>
          </div>
          <p class="mt-8 text-sm leading-relaxed text-gray-600">可用性、探测延迟、失败分布和告警响应时间都按固定周期统计，并作为容量评估与告警阈值调整的依据。指标来自系统自身的探测与看板，用于内部可靠性治理，不代表第三方审计认证。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pt-0">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="section-kicker">04 / ENGINEERING BOUNDARIES</p>
        <h2 class="section-title">它不声称什么</h2>
        <div class="section-rule" style={{ backgroundColor: accent }}></div>
      </div>
      <div class="space-y-3 lg:col-span-8">
        <div class="rounded-2xl border border-gray-200 bg-white p-6"><h3 class="text-sm font-bold text-gray-900">探测成功不代表服务健康</h3><p class="mt-2 text-sm leading-relaxed text-gray-600">端口可达与 SSH 可握手只证明边界存活，不代表业务逻辑正确、依赖可用或数据一致。</p></div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6"><h3 class="text-sm font-bold text-gray-900">告警触发不等于完成定位</h3><p class="mt-2 text-sm leading-relaxed text-gray-600">告警负责把人叫醒并给出入口，根因仍需结合指标、日志、链路与最近变更分析。</p></div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6"><h3 class="text-sm font-bold text-gray-900">自动化不能替代变更评审</h3><p class="mt-2 text-sm leading-relaxed text-gray-600">自动化扩大的是执行效率，变更仍需评审、灰度与回滚路径，关键操作保留人工确认。</p></div>
        <div class="rounded-2xl border border-gray-200 bg-white p-6"><h3 class="text-sm font-bold text-gray-900">监控覆盖不等于零故障</h3><p class="mt-2 text-sm leading-relaxed text-gray-600">没有被监控到的失败依然存在，覆盖率本身也需要通过故障演练持续检验。</p></div>
      </div>
    </div>
  </section>

  <section class="px-8 pb-24 pt-8 sm:px-12 md:px-16 md:pb-32 lg:px-24">
    <div class="mx-auto flex max-w-7xl flex-col justify-between gap-8 rounded-3xl p-8 text-white sm:p-12 md:flex-row md:items-end" style={{ backgroundColor: accent }}>
      <div>
        <p class="text-xs font-bold tracking-[0.18em] text-emerald-100">OPEN ENGINEERING ARTIFACT</p>
        <h2 class="mt-4 max-w-3xl text-3xl font-bold sm:text-4xl">代码、流水线与配置示例都在公开仓库中。</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-emerald-100">当前是 working pipeline，仓库会持续补充部署文档与配置示例。</p>
      </div>
      <a href={project.repo} target="_blank" rel="noopener noreferrer" class="shrink-0 rounded-lg bg-white px-5 py-3 text-sm font-bold text-emerald-700 transition-transform hover:-translate-y-0.5">查看 GitHub ↗</a>
    </div>
  </section>
</BaseLayout>
